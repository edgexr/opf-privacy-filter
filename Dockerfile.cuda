FROM nvcr.io/nvidia/pytorch:26.04-py3

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/openai/privacy-filter.git /app

COPY server.py /app/server.py

RUN pip install --no-cache-dir -e /app && \
    pip install --no-cache-dir fastapi "uvicorn[standard]" tiktoken

ENV OPF_DEVICE=cuda
ENV OPF_OUTPUT_MODE=typed
ENV CC=/usr/bin/gcc

RUN python - <<'PY'
import tiktoken
from opf._api import resolve_checkpoint_path
resolve_checkpoint_path(None)
print("privacy-filter deps OK")
PY

# Create non-root user
RUN useradd -m -s /bin/bash opf && \
    cp -r /root/.opf /home/opf/.opf && \
    chown -R opf:opf /home/opf/.opf
USER opf

ENV OPF_DEVICE=cuda
ENV OPF_OUTPUT_MODE=typed
ENV HOME=/home/opf

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
